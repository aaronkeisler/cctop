#!/usr/bin/env node

"use strict";

const { spawn, spawnSync } = require("child_process");
const { homedir } = require("os");
const { basename, join, resolve } = require("path");
const {
  chmodSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  renameSync,
  statSync,
  writeFileSync,
} = require("fs");

const args = process.argv.slice(2);
const sessionsDir = process.env.CCTOP_SESSIONS_DIR || join(homedir(), ".cctop", "sessions");

const optionsWithValues = new Set([
  "-c",
  "--config",
  "--enable",
  "--disable",
  "-i",
  "--image",
  "-m",
  "--model",
  "-p",
  "--profile",
  "-s",
  "--sandbox",
  "-a",
  "--ask-for-approval",
  "-C",
  "--cd",
  "--add-dir",
]);

const commandNames = new Set([
  "exec",
  "e",
  "review",
  "login",
  "logout",
  "mcp",
  "mcp-server",
  "app-server",
  "app",
  "completion",
  "sandbox",
  "debug",
  "apply",
  "a",
  "resume",
  "fork",
  "cloud",
  "features",
  "help",
]);

function nowIso() {
  return new Date().toISOString();
}

function codexHomeDir() {
  const envHome = process.env.CODEX_HOME;
  if (envHome && envHome.trim()) return resolve(envHome.trim());
  return join(homedir(), ".codex");
}

function collapseWhitespace(text) {
  return text.replace(/\s+/g, " ").trim();
}

function truncateText(text, max = 160) {
  if (text.length <= max) return text;
  return `${text.slice(0, max - 3)}...`;
}

function shellQuote(arg) {
  if (/^[A-Za-z0-9_./:=+-]+$/.test(arg)) return arg;
  return `'${arg.replace(/'/g, `'\\''`)}'`;
}

function commandSummary(cliArgs) {
  if (cliArgs.length === 0) return "codex";
  return `codex ${cliArgs.map(shellQuote).join(" ")}`;
}

function listJsonlFiles(dir) {
  let files = [];
  let entries = [];
  try {
    entries = readdirSync(dir, { withFileTypes: true });
  } catch {
    return files;
  }
  for (const entry of entries) {
    const fullPath = join(dir, entry.name);
    if (entry.isDirectory()) {
      files = files.concat(listJsonlFiles(fullPath));
      continue;
    }
    if (entry.isFile() && entry.name.endsWith(".jsonl")) {
      files.push(fullPath);
    }
  }
  return files;
}

function extractText(contentItem) {
  if (!contentItem || typeof contentItem !== "object") return null;
  if (typeof contentItem.text === "string") return contentItem.text;
  if (typeof contentItem.output_text === "string") return contentItem.output_text;
  if (typeof contentItem.input_text === "string") return contentItem.input_text;
  return null;
}

function readRecentLines(path, maxLines = 500) {
  let raw = "";
  try {
    raw = readFileSync(path, "utf8");
  } catch {
    return [];
  }
  const lines = raw.split("\n").filter(Boolean);
  if (lines.length <= maxLines) return lines;
  return lines.slice(lines.length - maxLines);
}

function readInitialLines(path, maxLines = 120) {
  let raw = "";
  try {
    raw = readFileSync(path, "utf8");
  } catch {
    return [];
  }
  const lines = raw.split("\n").filter(Boolean);
  if (lines.length <= maxLines) return lines;
  return lines.slice(0, maxLines);
}

function parseSessionMeta(path) {
  const lines = readInitialLines(path, 120);
  for (const line of lines) {
    let parsed;
    try {
      parsed = JSON.parse(line);
    } catch {
      continue;
    }
    if (parsed.type !== "session_meta") continue;
    const payload = parsed.payload || {};
    const rawTimestamp = typeof payload.timestamp === "string"
      ? payload.timestamp
      : (typeof parsed.timestamp === "string" ? parsed.timestamp : null);
    const parsedTs = rawTimestamp ? Date.parse(rawTimestamp) : Number.NaN;
    return {
      id: typeof payload.id === "string" ? payload.id : null,
      cwd: typeof payload.cwd === "string" ? payload.cwd : null,
      timestampMs: Number.isNaN(parsedTs) ? null : parsedTs,
    };
  }
  return null;
}

function latestContext(logPath) {
  const lines = readRecentLines(logPath, 800);
  for (let i = lines.length - 1; i >= 0; i -= 1) {
    let parsed;
    try {
      parsed = JSON.parse(lines[i]);
    } catch {
      continue;
    }

    if (parsed.type === "response_item") {
      const payload = parsed.payload || {};
      if (payload.type === "function_call" && typeof payload.name === "string") {
        const args = typeof payload.arguments === "string"
          ? collapseWhitespace(payload.arguments)
          : "";
        const detail = args ? `${payload.name} ${args}` : payload.name;
        return {
          kind: "tool",
          tool: payload.name,
          detail: truncateText(detail),
        };
      }

      if (payload.type === "message" && payload.role === "user") {
        const content = Array.isArray(payload.content) ? payload.content : [];
        for (const item of content) {
          const text = extractText(item);
          if (!text) continue;
          const normalized = collapseWhitespace(text);
          if (!normalized) continue;
          if (normalized.includes("AGENTS.md instructions")) continue;
          if (normalized.includes("<environment_context>")) continue;
          return { kind: "task", text: truncateText(normalized) };
        }
      }
    }

    if (parsed.type === "event_msg") {
      const payload = parsed.payload || {};
      if (payload.type !== "agent_message") continue;
      if (typeof payload.message !== "string") continue;
      const normalized = collapseWhitespace(payload.message);
      if (!normalized) continue;
      return { kind: "task", text: truncateText(normalized) };
    }
  }

  return null;
}

function latestStatus(logPath) {
  const lines = readRecentLines(logPath, 800);
  for (let i = lines.length - 1; i >= 0; i -= 1) {
    let parsed;
    try {
      parsed = JSON.parse(lines[i]);
    } catch {
      continue;
    }

    if (parsed.type === "event_msg") {
      const payload = parsed.payload || {};
      const kind = payload.type;
      if (kind === "task_complete") return "idle";
      if (kind === "task_started") return "working";
      if (kind === "user_message") return "working";
      if (kind === "agent_message") {
        if (payload.phase === "final_answer") return "idle";
        return "working";
      }
    }

    if (parsed.type === "response_item") {
      const payload = parsed.payload || {};
      if (payload.type === "function_call") return "working";
    }
  }
  return "working";
}

function codexSessionId(logPath) {
  const lines = readRecentLines(logPath, 100);
  for (const line of lines) {
    let parsed;
    try {
      parsed = JSON.parse(line);
    } catch {
      continue;
    }
    if (parsed.type !== "session_meta") continue;
    return parsed.payload?.id || null;
  }
  return null;
}

function findCodexSessionLog(projectPath, startedAtMs, knownSessionId) {
  const sessionsRoot = join(codexHomeDir(), "sessions");
  const allFiles = listJsonlFiles(sessionsRoot);
  if (allFiles.length === 0) return null;

  const candidates = [];
  for (const path of allFiles) {
    let modified = 0;
    try {
      modified = statSync(path).mtimeMs;
    } catch {
      continue;
    }
    if (modified + 10_000 < startedAtMs) continue;
    const meta = parseSessionMeta(path);
    if (!meta) continue;
    if (meta.cwd !== projectPath) continue;
    if (knownSessionId && meta.id !== knownSessionId) continue;

    const anchorTime = meta.timestampMs ?? modified;
    const distanceFromSpawnMs = Math.abs(anchorTime - startedAtMs);
    const startsNearSpawn = anchorTime + 10_000 >= startedAtMs;
    candidates.push({
      path,
      modified,
      startsNearSpawn,
      distanceFromSpawnMs,
    });
  }

  if (candidates.length === 0) return null;
  candidates.sort((a, b) => {
    if (a.startsNearSpawn !== b.startsNearSpawn) return a.startsNearSpawn ? -1 : 1;
    if (a.distanceFromSpawnMs !== b.distanceFromSpawnMs) {
      return a.distanceFromSpawnMs - b.distanceFromSpawnMs;
    }
    return b.modified - a.modified;
  });
  return candidates[0].path;
}

function resolveProjectPath(cliArgs) {
  let projectPath = process.cwd();
  for (let i = 0; i < cliArgs.length; i += 1) {
    const token = cliArgs[i];
    if (token === "-C" || token === "--cd") {
      if (i + 1 < cliArgs.length) {
        projectPath = resolve(cliArgs[i + 1]);
        i += 1;
      }
      continue;
    }
    if (token.startsWith("--cd=")) {
      projectPath = resolve(token.slice("--cd=".length));
    }
  }
  return projectPath;
}

function parseCommand(cliArgs) {
  for (let i = 0; i < cliArgs.length; i += 1) {
    const token = cliArgs[i];
    if (token === "--") {
      if (i + 1 < cliArgs.length && commandNames.has(cliArgs[i + 1])) return cliArgs[i + 1];
      return null;
    }
    if (token.startsWith("--cd=")) continue;
    if (token.startsWith("-")) {
      if (optionsWithValues.has(token)) i += 1;
      continue;
    }
    return commandNames.has(token) ? token : null;
  }
  return null;
}

function initialStatus(command) {
  void command;
  return "idle";
}

function gitBranch(cwd) {
  const result = spawnSync("git", ["branch", "--show-current"], {
    cwd,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "ignore"],
  });
  const branch = result.status === 0 ? result.stdout.trim() : "";
  return branch || "unknown";
}

function ttyName() {
  if (process.env.TTY) return process.env.TTY;
  const result = spawnSync("tty", { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
  if (result.status !== 0) return null;
  const value = result.stdout.trim();
  if (!value || value === "not a tty") return null;
  return value;
}

function elapsedToSeconds(etime) {
  // ps etime formats: [[dd-]hh:]mm:ss
  const trimmed = etime.trim();
  if (!trimmed) return null;
  const daySplit = trimmed.split("-");
  let days = 0;
  let rest = trimmed;
  if (daySplit.length === 2) {
    days = Number(daySplit[0]);
    rest = daySplit[1];
  }
  const parts = rest.split(":").map((v) => Number(v));
  if (parts.some((v) => Number.isNaN(v))) return null;
  let seconds = 0;
  if (parts.length === 3) {
    seconds = parts[0] * 3600 + parts[1] * 60 + parts[2];
  } else if (parts.length === 2) {
    seconds = parts[0] * 60 + parts[1];
  } else {
    return null;
  }
  return days * 86400 + seconds;
}

function processStartTime(pid) {
  const result = spawnSync("ps", ["-o", "etime=", "-p", String(pid)], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "ignore"],
  });
  if (result.status !== 0) return null;
  const elapsed = elapsedToSeconds(result.stdout);
  if (elapsed == null) return null;
  return Date.now() / 1000 - elapsed;
}

function writeSession(path, session) {
  mkdirSync(sessionsDir, { recursive: true, mode: 0o700 });
  const tmpPath = `${path}.${process.pid}.tmp`;
  writeFileSync(tmpPath, `${JSON.stringify(session, null, 2)}\n`);
  chmodSync(tmpPath, 0o600);
  renameSync(tmpPath, path);
}

const projectPath = resolveProjectPath(args);
const command = parseCommand(args);
const commandText = commandSummary(args);
const codexSessionIdEnv = process.env.CODEX_SESSION_ID || null;
const startedAt = nowIso();
const startedAtMs = Date.now();

const child = spawn("codex", args, {
  stdio: "inherit",
});

child.on("error", (error) => {
  process.stderr.write(`Failed to start codex: ${error.message}\n`);
  process.exit(1);
});

child.on("spawn", () => {
  const pid = child.pid;
  const sessionPath = join(sessionsDir, `${pid}.json`);
  const pidStartTime = processStartTime(pid);
  const logSearchStartedAtMs = Number.isFinite(pidStartTime)
    ? pidStartTime * 1000
    : startedAtMs;

  const session = {
    session_id: `codex-${pid}`,
    project_path: projectPath,
    project_name: basename(projectPath),
    branch: gitBranch(projectPath),
    status: initialStatus(command),
    last_prompt: null,
    last_activity: startedAt,
    started_at: startedAt,
    terminal: {
      program: process.env.TERM_PROGRAM || "",
      session_id: process.env.ITERM_SESSION_ID || process.env.KITTY_WINDOW_ID || null,
      tty: ttyName(),
    },
    pid,
    pid_start_time: pidStartTime,
    last_tool: "Task",
    last_tool_detail: commandText,
    notification_message: null,
    session_name: null,
    workspace_file: null,
    source: "codex",
  };

  let codexLogPath = null;
  const heartbeat = setInterval(() => {
    session.status = "idle";
    if (!codexLogPath) {
      codexLogPath = findCodexSessionLog(projectPath, logSearchStartedAtMs, codexSessionIdEnv);
    }
    if (codexLogPath) {
      session.status = latestStatus(codexLogPath);
      const context = latestContext(codexLogPath);
      if (context?.kind === "tool") {
        session.last_tool = context.tool;
        session.last_tool_detail = context.detail;
      } else if (context?.kind === "task") {
        session.last_prompt = context.text;
        session.last_tool = "Task";
        session.last_tool_detail = context.text;
      } else {
        session.last_tool = "Task";
        session.last_tool_detail = commandText;
      }
      const sessionId = codexSessionId(codexLogPath);
      if (sessionId) {
        session.session_id = sessionId;
      }
    }
    session.last_activity = nowIso();
    writeSession(sessionPath, session);
  }, 2000);

  writeSession(sessionPath, session);

  child.on("exit", (code, signal) => {
    clearInterval(heartbeat);
    session.last_activity = nowIso();
    session.ended_at = session.last_activity;
    if (code && code !== 0) {
      session.status = "needs_attention";
      session.notification_message = `codex exited with code ${code}`;
    } else if (signal) {
      session.status = "needs_attention";
      session.notification_message = `codex terminated by ${signal}`;
    }
    writeSession(sessionPath, session);
    if (signal) {
      process.kill(process.pid, signal);
      return;
    }
    process.exit(code ?? 0);
  });
});

for (const sig of ["SIGINT", "SIGTERM", "SIGHUP"]) {
  process.on(sig, () => {
    if (child.pid) child.kill(sig);
  });
}
